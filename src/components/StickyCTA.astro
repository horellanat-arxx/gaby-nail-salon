---
interface Props {
  buttonText?: string;
}

const { buttonText = "Reservar Cita" } = Astro.props;
---

<div class="fixed bottom-4 left-0 right-0 z-50 px-4 max-w-md mx-auto">
  <a 
    href="#agendar"
    class="w-full py-3.5 px-6 rounded-2xl bg-white text-black font-semibold text-center flex items-center justify-center gap-2 shadow-[0_10px_25px_-5px_rgba(255,255,255,0.3)] backdrop-blur-md border border-white/20 active:scale-[0.98] transition-all duration-200"
  >
    <span>{buttonText}</span>
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="m9 18 6-6-6-6"/>
    </svg>
  </a>
</div>