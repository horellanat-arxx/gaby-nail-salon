---
const services = [
  {
    id: "01",
    title: "Consulta Inicial & Diagnóstico",
    price: "$25",
    duration: "30 min",
    description: "Evaluación completa personalizada para definir los requerimientos de tu proyecto o servicio."
  },
  {
    id: "02",
    title: "Sesión Premium Completa",
    price: "$60",
    duration: "60 min",
    description: "Trabajo enfocado y ejecución directa paso a paso para resultados de alto nivel."
  },
  {
    id: "03",
    title: "Asesoría Continuada",
    price: "$100",
    duration: "2 horas",
    description: "Acompañamiento prioritario con resolución de dudas e integración completa."
  }
];
---

<section id="servicios" class="py-12 px-6 max-w-md mx-auto">
  <div class="mb-8">
    <span class="text-xs font-semibold uppercase tracking-widest text-neutral-500">Catálogo</span>
    <h2 class="text-3xl font-extrabold text-white mt-1">Elige tu servicio</h2>
  </div>

  <div class="space-y-4">
    {services.map((service) => (
      <div class="group relative bg-neutral-900/80 border border-neutral-800 rounded-2xl p-5 hover:border-neutral-700 transition-all duration-200 active:scale-[0.99] cursor-pointer">
        <div class="flex justify-between items-start mb-2">
          <span class="text-xs font-mono text-neutral-500">{service.id}</span>
          <span class="text-xs font-medium bg-neutral-800 text-neutral-300 px-2.5 py-1 rounded-full border border-neutral-700">
            {service.duration}
          </span>
        </div>
        <h3 class="text-lg font-bold text-white mb-1 group-hover:text-neutral-200">{service.title}</h3>
        <p class="text-xs text-neutral-400 mb-4 leading-relaxed">{service.description}</p>
        <div class="flex items-center justify-between pt-3 border-t border-neutral-800/80">
          <span class="text-lg font-black text-white">{service.price}</span>
          <span class="text-xs font-semibold text-neutral-300 flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
            Seleccionar
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </span>
        </div>
      </div>
    ))}
  </div>
</section>