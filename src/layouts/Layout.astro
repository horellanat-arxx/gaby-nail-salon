---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "Brinails 💗 | Agenda tu cita" } = Astro.props;
---

<!doctype html>
<html lang="es" class="bg-pink-50 text-neutral-800 antialiased scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-gradient-to-b from-pink-100/60 via-pink-50 to-white text-neutral-800 min-h-screen selection:bg-pink-300 selection:text-pink-900">
    <slot />
  </body>
</html>