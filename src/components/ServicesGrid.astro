---
const servicesData = [
  {
    number: "01",
    id: "acrilico",
    title: "ACRÍLICO",
    tagline: "Estructura & Máxima Durabilidad",
    subtitle: "Largo, resistencia y acabado impecable.",
    img1: "/acrilico-1.jpg",
    img2: "/acrilico-2.jpg",
    type: "video",
    media: "/acrilico-video.mp4",
    description: "Si buscas extensiones con largo impactante, formas definidas (coffin, almond, stiletto) y resistencia total para el día a día. Es la técnica clásica perfecta para lucir diseños elaborados que duran semanas intactos."
  },
  {
    number: "02",
    id: "softgel",
    title: "SOFT GEL",
    tagline: "Flexibilidad & Acabado Natural",
    subtitle: "Ligeras, ultranaturales y de aplicación rápida.",
    img1: "/softgel-1.jpg",
    img2: "/softgel-2.jpg",
    type: "video",
    media: "/softgel-video.mp4",
    description: "Cápsulas de gel completas que se adhieren directamente a tu uña. Se sienten súper livianas, no pesan absolutamente nada y el acabado parece 100% tuyo con un brillo de nivel profesional."
  },
  {
    number: "03",
    id: "rubber",
    title: "RUBBER BASE",
    tagline: "Nivelación & Protección",
    subtitle: "Fuerza y volumen para tu uña natural.",
    img1: "/rubber-1.jpg",
    img2: "/rubber-2.jpg",
    type: "image",
    media: "/rubber-3.jpg",
    description: "La base elástica ideal si tus uñas son quebradizas o planas. Aporta grosor y curva de forma sutil sin necesidad de extensión, protegiendo el crecimiento natural con un acabado impecable."
  },
  {
    number: "04",
    id: "acripie",
    title: "ACRIPIE",
    tagline: "Estética & Reconstrucción",
    subtitle: "Pies perfectos y esmaltado duradero.",
    img1: "/acripie-1.jpg",
    img2: "/acripie-2.jpg",
    type: "image",
    media: "/acripie-3.jpg",
    description: "Técnica de acrílico adaptada a los pies para emparejar la forma de las uñas, reconstruir esquinas y mantener un pedicura intacto por semanas con acabado brillante."
  }
];
---

<section class="bg-black text-white py-16 px-4 sm:px-8 max-w-7xl mx-auto space-y-28">
  {servicesData.map((service) => (
    <article id={service.id} class="relative pt-12">
      
      <!-- Separador de Sección Minimalista -->
      <div class="flex items-center justify-between pb-6 mb-8 border-b border-neutral-800">
        <div class="flex items-center gap-4">
          <span class="text-xs font-mono tracking-widest text-neutral-500">{service.number}</span>
          <span class="h-3 w-[1px] bg-neutral-700"></span>
          <span class="text-xs font-semibold tracking-[0.25em] uppercase text-neutral-400">
            {service.tagline}
          </span>
        </div>
        <span class="text-xs font-semibold tracking-wider text-neutral-500 uppercase">Gaby Nail Salón</span>
      </div>

      <!-- Bloque de Contenido -->
      <div class="space-y-6">
        
        <!-- Fila Superior: 2 Fotos -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="aspect-[4/3] bg-neutral-900 rounded-xl overflow-hidden border border-neutral-800/80 shadow-2xl">
            <img src={service.img1} alt={`${service.title} 1`} class="w-full h-full object-cover" />
          </div>
          <div class="aspect-[4/3] bg-neutral-900 rounded-xl overflow-hidden border border-neutral-800/80 shadow-2xl">
            <img src={service.img2} alt={`${service.title} 2`} class="w-full h-full object-cover" />
          </div>
        </div>

        <!-- Fila Inferior: Video o 3ra Foto (Izquierda) + Tarjeta (Derecha) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
          
          <div class="aspect-[16/10] bg-neutral-900 rounded-xl overflow-hidden border border-neutral-800/80 shadow-2xl relative">
            {service.type === "video" ? (
              <video 
                src={service.media} 
                autoplay 
                loop 
                muted 
                playsinline 
                class="w-full h-full object-cover"
              ></video>
            ) : (
              <img 
                src={service.media} 
                alt={`${service.title} 3`} 
                class="w-full h-full object-cover"
              />
            )}
          </div>

          <!-- Información y botón -->
          <div class="bg-neutral-950/80 backdrop-blur-sm border border-neutral-800/80 rounded-xl p-8 flex flex-col justify-between shadow-2xl">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-[10px] font-semibold tracking-[0.2em] text-neutral-500 uppercase">Técnica</span>
                <span class="text-xs font-bold tracking-wider bg-white/10 text-white px-3 py-1 rounded-full border border-white/10">
                </span>
              </div>
              
              <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight uppercase text-white mb-2">
                {service.title}
              </h2>
              
              <p class="text-xs font-semibold text-neutral-300 uppercase tracking-wider mb-4">
                {service.subtitle}
              </p>

              <p class="text-xs sm:text-sm text-neutral-400 font-normal leading-relaxed tracking-wide">
                {service.description}
              </p>
            </div>

            <div class="pt-6 mt-6 border-t border-neutral-800/80 flex justify-between items-center">
              <button 
                type="button"
                data-service={service.title}
                class="btn-reserve-item inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-white hover:text-neutral-300 transition-colors cursor-pointer"
              >
                <span>Reservar {service.title}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </button>
            </div>
          </div>

        </div>

      </div>

    </article>
  ))}
</section>

<script>
  document.querySelectorAll('.btn-reserve-item').forEach(button => {
    button.addEventListener('click', () => {
      const serviceName = button.getAttribute('data-service');
      window.dispatchEvent(new CustomEvent('open-booking-modal', { 
        detail: { service: serviceName } 
      }));
    });
  });
</script>